# =============================================================================
# Docker 环境配置模板 - xiaodashi-web Backend
# =============================================================================
# 使用说明：
# 1. 复制此文件为 .env.docker
# 2. 根据实际环境填写配置
# 3. 生产环境请使用强密码和安全配置
# =============================================================================

# ============================================================================
# 应用基础配置
# ============================================================================

# 运行环境 (development | production)
NODE_ENV=production

# 应用名称
APP_NAME=xiaodashi-web

# Docker Compose 项目名称（用于容器组标识和管理）
COMPOSE_PROJECT_NAME=xiaodashi-app-backend

# 服务端口
PORT=2999

# API路径前缀
API_PREFIX=api

# 前端应用URL（用于CORS和邮件链接）
FRONTEND_URL=https://your-domain.com
FRONTEND_APP_URL=https://app.your-domain.com

# ============================================================================
# 阿里云 PostgreSQL 数据库配置
# ============================================================================

# 阿里云 RDS PostgreSQL 连接信息
# 示例: pg-xxxxx.pg.rds.aliyuncs.com
DB_HOST=your-aliyun-rds-host
DB_PORT=5432
DB_USER=xiaodashi
DB_PASSWORD=your_secure_database_password
DB_NAME=xiaodashi_prod

# SSL配置（阿里云RDS推荐启用）
DB_SSL=true

# 连接超时时间 (毫秒)
DB_CONNECTION_TIMEOUT=60000

# 连接池配置
DB_POOL_MIN=2
DB_POOL_MAX=20

# TypeORM配置
DB_SYNCHRONIZE=false
DB_LOGGING=error

# ============================================================================
# Redis 缓存配置 (可选)
# ============================================================================

# 阿里云 Redis 连接信息
REDIS_HOST=your-aliyun-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Redis 连接字符串 (可选，优先级高于单独配置)
# REDIS_URL=redis://username:password@host:port/db

# 缓存TTL配置 (秒)
CACHE_TTL=3600

# ============================================================================
# JWT 认证配置
# ============================================================================

# JWT 密钥配置 (生产环境请使用强密钥)
# 生成强密钥命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production

# 令牌过期时间
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT 签发者和受众
JWT_ISSUER=xiaodashi-web
JWT_AUDIENCE=xiaodashi-users

# ============================================================================
# 密码加密配置
# ============================================================================

# bcrypt 加密轮数 (10-12 推荐)
BCRYPT_SALT_ROUNDS=12

# ============================================================================
# 安全配置
# ============================================================================

# CORS 允许的源地址 (多个地址用逗号分隔)
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
CORS_CREDENTIALS=true

# 限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 登录限流
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# 会话配置
SESSION_SECRET=your-session-secret-key-change-this-in-production
SESSION_MAX_AGE=86400000

# ============================================================================
# 验证码配置
# ============================================================================

# 登录验证码开关
CAPTCHA_ENABLED=true

# 触发验证码的失败次数阈值
CAPTCHA_TRIGGER_ATTEMPTS=3

# 验证码过期时间(分钟)
CAPTCHA_EXPIRE_TIME=5

# 最大验证尝试次数
CAPTCHA_MAX_ATTEMPTS=3

# 验证码复杂度 (1-5)
CAPTCHA_COMPLEXITY=4

# 可疑IP阈值
CAPTCHA_SUSPICIOUS_IP_THRESHOLD=5

# ============================================================================
# 日志配置
# ============================================================================

# 日志级别 (error | warn | info | debug)
LOG_LEVEL=info

# 是否启用控制台日志
LOG_CONSOLE=true

# 是否启用文件日志
LOG_FILE=false

# 日志文件路径 (如果启用文件日志)
LOG_FILE_PATH=logs/app.log

# ============================================================================
# 开发和调试配置
# ============================================================================

# 是否启用 Swagger API 文档 (生产环境建议关闭)
SWAGGER_ENABLED=false

# Swagger 访问路径
SWAGGER_PATH=api-docs

# 是否启用调试模式
DEBUG=false

# 是否显示详细错误信息 (生产环境建议关闭)
SHOW_ERROR_DETAILS=false

# ============================================================================
# 监控和健康检查
# ============================================================================

# 健康检查配置
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=health

# ============================================================================
# 特性开关
# ============================================================================

# 是否启用用户注册
ENABLE_USER_REGISTRATION=true

# 是否启用邮箱验证
ENABLE_EMAIL_VERIFICATION=true

# 是否启用双因子认证
ENABLE_2FA=false

# 是否启用社交登录
ENABLE_SOCIAL_LOGIN=false

# ============================================================================
# 业务配置
# ============================================================================

# 默认用户角色
DEFAULT_USER_ROLE=user

# 用户名最小长度
MIN_USERNAME_LENGTH=2

# 密码最小长度
MIN_PASSWORD_LENGTH=8

# 最大登录尝试次数
MAX_LOGIN_ATTEMPTS=5

# 账户锁定时间 (分钟)
ACCOUNT_LOCKOUT_TIME=15

# ============================================================================
# Docker 镜像配置
# ============================================================================

# 镜像完整名称（可包含仓库地址和命名空间）
# 示例：
#   - 本地镜像: xiaodashi-backend
#   - 阿里云: registry.cn-hangzhou.aliyuncs.com/your-namespace/xiaodashi-backend
#   - Harbor: harbor.example.com/production/xiaodashi-backend
IMAGE_NAME=registry.cn-beijing.aliyuncs.com/huyuan/xiao-da-shi-app-backend

# 镜像版本标签
IMAGE_TAG=latest

# 阿里云访问凭证 (用于推送镜像)
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-secret-key

# ============================================================================
# 邮件服务配置 (可选)
# ============================================================================

# SMTP 配置
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@your-domain.com
SMTP_PASSWORD=your-smtp-password

# 发件人信息
EMAIL_FROM_NAME=肖大师团队
EMAIL_FROM_ADDRESS=noreply@your-domain.com

# ============================================================================
# 生产环境安全检查清单
# ============================================================================
#
# 部署前请确认以下配置已正确设置：
#
# ✅ 修改所有默认密码和密钥
# ✅ 设置正确的数据库连接信息
# ✅ 启用SSL/TLS连接
# ✅ 配置正确的CORS源地址
# ✅ 关闭Swagger文档(生产环境)
# ✅ 关闭调试模式
# ✅ 设置强JWT密钥
# ✅ 配置监控和日志
# ✅ 设置阿里云访问凭证
#
# ============================================================================