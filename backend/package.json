{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:warnings": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "quality-check": "npm run lint:warnings && npm run test:warnings && npm run build",
    "quality-check:ci": "npm run lint:warnings && npm run test:ci && npm run build",
    "check:warnings": "ts-node scripts/check-warnings.ts",
    "test": "jest --verbose",
    "test:watch": "jest --watch --verbose",
    "test:cov": "jest --coverage --verbose",
    "test:ci": "jest --coverage --watchAll=false --ci --verbose",
    "test:warnings": "jest --verbose --no-cache --watchAll=false",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --verbose",
    "test:e2e": "jest --config ./test/jest-e2e.json --verbose",
    "openapi:gen": "ts-node scripts/generate-openapi.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d typeorm.config.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d typeorm.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d typeorm.config.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d typeorm.config.ts",
    "_comment_multi_db": "=== 预留多数据库 Migration 脚本（未来使用时取消注释） ===",
    "_migration:user:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/datasources/user.datasource.ts",
    "_migration:user:create": "typeorm-ts-node-commonjs migration:create",
    "_migration:user:run": "typeorm-ts-node-commonjs migration:run -d src/database/datasources/user.datasource.ts",
    "_migration:user:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/datasources/user.datasource.ts",
    "_migration:user:show": "typeorm-ts-node-commonjs migration:show -d src/database/datasources/user.datasource.ts",
    "_migration:auth:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/datasources/auth.datasource.ts",
    "_migration:auth:create": "typeorm-ts-node-commonjs migration:create",
    "_migration:auth:run": "typeorm-ts-node-commonjs migration:run -d src/database/datasources/auth.datasource.ts",
    "_migration:auth:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/datasources/auth.datasource.ts",
    "_migration:auth:show": "typeorm-ts-node-commonjs migration:show -d src/database/datasources/auth.datasource.ts",
    "_migration:all:run": "npm run migration:user:run && npm run migration:auth:run",
    "_migration:all:show": "npm run migration:user:show && npm run migration:auth:show",
    "_migration:all:revert": "npm run migration:auth:revert && npm run migration:user:revert"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/pg": "^8.15.5",
    "@xiaodashi/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "geoip-lite": "^1.4.10",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "svg-captcha": "^1.4.0",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}