# ============================================================================
# 肖大师 (xiaodashi-web) Backend Environment Configuration Template
# ============================================================================
#
# 说明：
# 1. 复制此文件为 .env 并填入实际值
# 2. 生产环境请使用强密码和安全配置
# 3. 不要将 .env 文件提交到版本控制系统
# 4. 敏感信息请使用环境变量或密钥管理系统
#
# ============================================================================

# ============================================================================
# 应用基础配置 (Application Configuration)
# ============================================================================

# 运行环境 (development | test | production)
NODE_ENV=development

# 应用名称
APP_NAME=xiaodashi-web

# 服务端口
PORT=3001

# API路径前缀
API_PREFIX=api

# 应用版本（可选，默认自动从 package.json 读取）
# 生产环境如需覆盖版本号（如添加构建号、Git hash）可取消注释
# 示例：APP_VERSION=1.1.0-rc1 或 APP_VERSION=1.1.0-a1b2c3d
# APP_VERSION=1.1.0

# 前端应用URL（用于CORS和邮件链接）
FRONTEND_URL=http://localhost:3000
FRONTEND_APP_URL=http://localhost:3001

# ============================================================================
# 数据库配置 (Database Configuration)
# ============================================================================

# PostgreSQL 连接配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=xiaodashi

# 数据库连接字符串（可选，优先级高于单独配置）
# DB_CONNECTION_STRING=postgresql://user:password@host:port/database

# 数据库SSL配置 (true | false)
DB_SSL=false

# 连接池配置
DB_POOL_MIN=2
DB_POOL_MAX=10

# 连接超时时间 (毫秒)
DB_CONNECTION_TIMEOUT=60000
DB_ACQUIRE_TIMEOUT=60000

# TypeORM配置
# 是否自动同步数据库结构 (仅开发环境使用)
DB_SYNCHRONIZE=false

# 是否启用查询日志 (true | false | 'all' | 'error')
DB_LOGGING=error

# Migration配置
DB_RUN_MIGRATIONS=false

# ============================================================================
# JWT 认证配置 (JWT Authentication)
# ============================================================================

# JWT 密钥配置 (生产环境请使用强密钥)
# 生成强密钥: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# 访问令牌密钥 (必须设置)
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production

# 刷新令牌密钥 (必须设置)
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production

# 令牌过期时间
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT 签发者
JWT_ISSUER=xiaodashi-web

# JWT 受众
JWT_AUDIENCE=xiaodashi-users

# ============================================================================
# 密码加密配置 (Password Encryption)
# ============================================================================

# bcrypt 加密轮数 (10-12 推荐)
BCRYPT_SALT_ROUNDS=12

# ============================================================================
# 安全配置 (Security Configuration)
# ============================================================================

# CORS 允许的源地址 (多个地址用逗号分隔)
# 支持以下格式：
# 1. 精确匹配：https://app.xds.sxx0.com
# 2. 通配符匹配：*.sxx0.com 或 https://*.sxx0.com
# 3. 正则表达式：/^https:\/\/.*\.sxx0\.com$/
#
# 开发环境示例：
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
#
# 生产环境示例（推荐）：
# CORS_ORIGINS=https://app.xds.sxx0.com,https://admin.xds.sxx0.com
#
# 生产环境示例（通配符，支持所有子域名）：
# CORS_ORIGINS=https://*.sxx0.com
#
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 是否启用 CORS 凭证（允许发送 Cookie 和 Authorization）
# 生产环境必须设置为 true
CORS_CREDENTIALS=true

# 限流配置 (每个IP每窗口期内的请求次数)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 登录限流 (每个IP每窗口期内的登录尝试次数)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# 会话配置
SESSION_SECRET=your-session-secret-key-change-this-in-production
SESSION_MAX_AGE=86400000

# 验证码配置 (Captcha Configuration)
# 是否在登录时启用验证码校验（不影响验证码API功能）
CAPTCHA_ENABLED=false

# 触发验证码的失败次数阈值
CAPTCHA_TRIGGER_ATTEMPTS=2

# 验证码过期时间(分钟)
CAPTCHA_EXPIRE_TIME=5

# 最大验证尝试次数
CAPTCHA_MAX_ATTEMPTS=3

# 验证码复杂度 (1-5)
CAPTCHA_COMPLEXITY=3

# 可疑IP阈值
CAPTCHA_SUSPICIOUS_IP_THRESHOLD=5

# ============================================================================
# Redis 配置 (Caching & Session Store)
# ============================================================================

# Redis 连接配置 (可选)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Redis 连接字符串 (可选)
# REDIS_URL=redis://localhost:6379

# 缓存TTL配置 (秒)
# CACHE_TTL=3600

# ============================================================================
# 邮件服务配置 (Email Service)
# ============================================================================

# SMTP 配置
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password

# 发件人信息
# EMAIL_FROM_NAME=肖大师团队
# EMAIL_FROM_ADDRESS=noreply@xiaodashi.com

# 邮件模板配置
# EMAIL_TEMPLATES_DIR=templates/emails
# EMAIL_BASE_URL=http://localhost:3000

# ============================================================================
# 文件上传配置 (File Upload)
# ============================================================================

# 文件上传限制
# MAX_FILE_SIZE=5242880
# ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# 文件存储路径
# UPLOAD_DEST=uploads
# STATIC_FILES_PATH=public

# ============================================================================
# 第三方服务配置 (Third-party Services)
# ============================================================================

# AWS 配置 (如使用 S3 存储)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-s3-bucket-name

# 阿里云 OSS 配置 (可选)
# ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key
# ALIYUN_ACCESS_KEY_SECRET=your-aliyun-secret-key
# ALIYUN_OSS_REGION=oss-cn-beijing
# ALIYUN_OSS_BUCKET=your-oss-bucket-name

# 短信服务配置 (可选)
# SMS_ACCESS_KEY_ID=your-sms-access-key
# SMS_ACCESS_KEY_SECRET=your-sms-secret-key
# SMS_SIGN_NAME=肖大师
# SMS_TEMPLATE_CODE=SMS_123456

# ============================================================================
# 日志配置 (Logging Configuration)
# ============================================================================

# 日志级别 (error | warn | info | debug | verbose)
LOG_LEVEL=info

# 日志文件路径
# LOG_FILE_PATH=logs/app.log

# 是否启用控制台日志
LOG_CONSOLE=true

# 是否启用文件日志
# LOG_FILE=false

# 日志轮转配置
# LOG_MAX_SIZE=20m
# LOG_MAX_FILES=14

# ============================================================================
# 开发和调试配置 (Development & Debug)
# ============================================================================

# 是否启用 Swagger API 文档 (true | false)
SWAGGER_ENABLED=true

# Swagger 访问路径
SWAGGER_PATH=api-docs

# 是否启用调试模式
DEBUG=false

# 是否显示详细错误信息
SHOW_ERROR_DETAILS=true

# 是否启用性能监控
# ENABLE_PROFILING=false

# 是否启用数据库查询日志
# DB_QUERY_LOGGING=false

# ============================================================================
# 监控和健康检查 (Monitoring & Health Check)
# ============================================================================

# 健康检查配置
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=health

# 应用监控配置 (如 New Relic, Datadog 等)
# MONITORING_ENABLED=false
# MONITORING_API_KEY=your-monitoring-api-key

# ============================================================================
# 特性开关 (Feature Flags)
# ============================================================================

# 是否启用用户注册
ENABLE_USER_REGISTRATION=true

# 是否启用邮箱验证
ENABLE_EMAIL_VERIFICATION=true

# 是否启用双因子认证
# ENABLE_2FA=false

# 是否启用社交登录
# ENABLE_SOCIAL_LOGIN=false

# ============================================================================
# 业务配置 (Business Configuration)
# ============================================================================

# 默认用户角色
DEFAULT_USER_ROLE=user

# 用户名最小长度
MIN_USERNAME_LENGTH=2

# 密码最小长度
MIN_PASSWORD_LENGTH=8

# 最大登录尝试次数
MAX_LOGIN_ATTEMPTS=5

# 账户锁定时间 (分钟)
ACCOUNT_LOCKOUT_TIME=15

# ============================================================================
# 生产环境特殊配置 (Production Only)
# ============================================================================

# 生产环境请务必修改以下配置：
# 1. 所有密钥和密码
# 2. 数据库连接信息
# 3. 关闭调试选项
# 4. 启用 SSL/TLS
# 5. 配置防火墙和访问控制
# 6. 设置监控和日志收集

# ============================================================================
# 环境变量验证检查清单
# ============================================================================
#
# 开发环境必需：
# ✓ NODE_ENV
# ✓ PORT
# ✓ DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME
# ✓ JWT_ACCESS_SECRET, JWT_REFRESH_SECRET
#
# 生产环境必需：
# ✓ 所有开发环境变量
# ✓ 强密码和密钥
# ✓ 正确的数据库配置
# ✓ SSL/TLS 配置
# ✓ 监控和日志配置
# ✓ 第三方服务配置
#
# ============================================================================