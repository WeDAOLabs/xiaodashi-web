# ============================================
# 客户端环境变量（NEXT_PUBLIC_ 前缀）
# 这些变量会暴露到浏览器端
# ============================================

# Backend API 地址（包含完整的 API 版本前缀）
# 开发环境: http://localhost:2999/api/v1
# 生产环境: 在 Vercel 项目设置中配置（例如: https://api.yourdomain.com/api/v1）
APP_BACKEND_URL=http://localhost:2999/api/v1

# Token 刷新配置（秒）
# Token 过期前多少秒开始自动刷新
TOKEN_REFRESH_BEFORE_EXPIRY=300

# ============================================
# 服务端环境变量（仅在 Next.js 服务端可用）
# ⚠️ 这些变量不会暴露到客户端
# ============================================

# JWT Secret（与 backend 保持一致）
# ⚠️ 此变量仅在服务端使用（API Routes, Server Components, Middleware）
# ⚠️ 必须与 backend 的 JWT_SECRET 保持一致
JWT_SECRET=your-super-secret-key-at-least-32-chars

# ============================================
# 第三方 API 密钥（可选）
# 用于 Next.js API Routes 代理第三方 API 调用
# ============================================

# OpenAI API Key（如需要）
# OPENAI_API_KEY=sk-your-openai-key

# Claude API Key（如需要）
# CLAUDE_API_KEY=your-claude-key
