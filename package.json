{
  "name": "xiaodashi-web",
  "private": true,
  "workspaces": [
    "frontend",
    "frontend-app",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:frontend-app": "npm run dev --workspace=frontend-app",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build:shared": "npm run build --workspace=shared",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=frontend-app",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:frontend-app": "npm run lint --workspace=frontend-app",
    "build:all": "npm run build:shared && npm run build --workspace=frontend && npm run build --workspace=frontend-app"
  },
  "dependencies": {},
  "devDependencies": {}
}